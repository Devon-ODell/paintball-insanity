/Packages/
/ServerPackages/
/DevPackages/
/build/
*.rbxl
*.rbxlx
*.rbxlx.lock
/Saved/Sims/*.json
!/Saved/Sims/.gitkeep
.DS_Store

# Rojo sourcemaps embed absolute local filesystem paths.
sourcemap.json
*.sourcemap.json

# Editor/local settings.
.vscode/
.idea/

# Never commit credentials. Nothing in this project needs any, so a file
# matching these patterns appearing is a mistake, not a new feature.
.env
.env.*
*.key
*.pem
*.p12
secrets.*
*.secret

# Audio you supply is staged in assets/audio/ and uploaded to Roblox; the folder
# structure and its README are tracked, the media is not. Mixes are large
# binaries and this is an open-source repository. Add an exception deliberately
# if a particular track should ship with the source.
assets/audio/**/*.mp3
assets/audio/**/*.ogg
assets/audio/**/*.wav
assets/audio/**/*.flac
assets/audio/**/*.aif
assets/audio/**/*.aiff
assets/audio/**/*.m4a
