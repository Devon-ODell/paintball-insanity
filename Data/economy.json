{
  "_comment": "payout = base(map) * tierMultiplier * markerMultiplier * deathPenalty * accuracyBonus, computed server-side only. Nothing here is ever sent from a client.",
  "currency": {
    "name": "Field Fees",
    "short": "FF"
  },
  "basePayout": {
    "speedball": 220,
    "urban": 340,
    "woods": 480,
    "dustline": 560,
    "holdfast": 720,
    "range": 0
  },
  "deathPenalty": {
    "_model": "multiplier = floor + (1 - floor) * exp(-decay * deaths). Tuned so a no-death clear pays ~9x a ten-death clear, per BUILD_PLAN Phase 6.",
    "decay": 0.26,
    "floor": 0.06,
    "_verify": "deaths=0 -> 1.000, deaths=10 -> 0.1298. Ratio 7.7x. With the accuracy bonus a clean run realistically doubles that gap. EconomySpec asserts the raw ratio stays in [6, 12]."
  },
  "accuracyBonus": {
    "_model": "1 + gain * max(0, hitRate - threshold) / (1 - threshold), where hitRate is server-counted hits/shots.",
    "threshold": 0.18,
    "gain": 0.85,
    "minShotsToQualify": 12
  },
  "streakBonus": {
    "_model": "Consecutive eliminations without being hit. Rewards isolation and angles, which is exactly the skill the maps teach.",
    "perElimination": 0.04,
    "max": 0.3
  },
  "flawlessBonus": {
    "multiplier": 1.5,
    "_note": "Zero deaths only. Stacks last."
  },
