{
  "name": "PROJECT_LIVEROUND",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": { "$path": "src/ReplicatedStorage/Shared" },
      "Net": { "$path": "src/ReplicatedStorage/Net" },
      "Data": { "$path": "Data" },
      "Packages": { "$path": { "optional": "Packages" } }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": { "$path": "src/ServerScriptService" },
      "ServerPackages": { "$path": { "optional": "ServerPackages" } }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": { "$path": "src/StarterPlayer/Client" }
      }
    },

    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "FilteringEnabled": true,
        "StreamingEnabled": false,
        "Gravity": 196.2
      }
    },

    "MaterialService": {
      "$className": "MaterialService",
      "$properties": { "Use2022Materials": true }
    },

    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Technology": "Future",
        "LightingStyle": "Realistic",
        "PrioritizeLightingQuality": true,
        "Ambient": [0.35, 0.36, 0.42],
        "OutdoorAmbient": [0.42, 0.44, 0.5],
        "Brightness": 2.6,
        "GlobalShadows": true,
        "ClockTime": 14.5,
        "GeographicLatitude": 24,
        "EnvironmentDiffuseScale": 0.55,
        "EnvironmentSpecularScale": 0.35,
        "ShadowSoftness": 0.28
      }
    },

    "SoundService": {
      "$className": "SoundService",
      "$properties": { "RespectFilteringEnabled": true }
    },

    "Players": {
      "$className": "Players",
      "$properties": {
        "CharacterAutoLoads": false,
        "RespawnTime": 0.5
      }
    }
  }
}
